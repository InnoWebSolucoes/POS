{
  "name": "pos-system",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant POS: retail, restaurant and online store. pt-PT / AOA first.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "predev": "npm run build -w @pos/shared",
    "dev": "concurrently -n shared,api,web -c gray,cyan,magenta \"npm:dev:shared\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:shared": "npm run dev -w @pos/shared",
    "dev:api": "npm run dev -w @pos/api",
    "dev:web": "npm run dev -w @pos/web",
    "build": "npm run build -w @pos/shared && npm run build -w @pos/api && npm run build -w @pos/web",
    "typecheck": "npm run typecheck -w @pos/shared && npm run typecheck -w @pos/api && npm run typecheck -w @pos/web",
    "lint": "npm run typecheck",
    "setup": "node scripts/setup.mjs",
    "db:generate": "npm run db:generate -w @pos/api",
    "db:push": "npm run db:push -w @pos/api",
    "db:seed": "npm run db:seed -w @pos/api",
    "db:studio": "npm run db:studio -w @pos/api",
    "db:reset": "npm run db:reset -w @pos/api",
    "test": "npm run test -w @pos/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
