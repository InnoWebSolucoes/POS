# syntax=docker/dockerfile:1

# --- build -------------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /app

# Workspace manifests first, so a dependency-only change reuses the layer below.
COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/

RUN npm ci --workspace @pos/shared --workspace @pos/api --include-workspace-root

COPY packages/shared packages/shared
COPY apps/api apps/api
COPY scripts scripts

# Production runs on PostgreSQL; the schema ships defaulting to sqlite for
# local development, so flip it before generating the client.
RUN node scripts/set-db-provider.mjs postgresql \
 && npm run build --workspace @pos/shared \
 && npx prisma generate --schema apps/api/prisma/schema.prisma \
 && npm run build --workspace @pos/api

# --- runtime -----------------------------------------------------------------
FROM node:22-alpine AS runtime
WORKDIR /app

ENV NODE_ENV=production
RUN apk add --no-cache tini && addgroup -S pos && adduser -S pos -G pos

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/package.json ./package.json
COPY docker/entrypoint-api.sh /usr/local/bin/entrypoint.sh

RUN chmod +x /usr/local/bin/entrypoint.sh \
 && mkdir -p /data/uploads && chown -R pos:pos /data/uploads /app

USER pos
WORKDIR /app/apps/api
EXPOSE 4000

ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["node", "dist/index.js"]
