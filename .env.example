# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (no Postgres needed) -> SQLite
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"

# Production / docker-compose -> PostgreSQL
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://pos:pos@localhost:5432/pos?schema=public"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ACCESS_TTL=8h
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:5173

# File storage: "local" or "s3"
STORAGE_DRIVER=local
UPLOAD_DIR=../../uploads
PUBLIC_UPLOAD_BASE=/uploads

# S3-compatible (only when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Defaults for the first installation
# ---------------------------------------------------------------------------
SUPERADMIN_EMAIL=admin@pos.local
SUPERADMIN_PASSWORD=admin123
DEFAULT_LOCALE=pt-PT
DEFAULT_CURRENCY=AOA

# ---------------------------------------------------------------------------
# Web (Vite)
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
